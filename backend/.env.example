# Copie este arquivo para ".env" (mesma pasta) e ajuste para a sua máquina.
# O .env não vai para o git: cada pessoa tem o seu.

# Pasta do JDK 21+ (a que contém "bin\java.exe"). Sem aspas.
# Se o JAVA_HOME já estiver configurado no Windows, pode deixar comentado.
JAVA_HOME=C:\Program Files\Java\jdk-21
