# ==================================================
/backend/target/
/backend/HELP.md
/backend/.mvn/wrapper/maven-wrapper.jar
/backend/.vscode/
/backend/build/
*.class

# Banco SQLite local (cada um tem o seu; é recriado ao subir a API)
*.db
*.db-journal
*.sqlite
*.sqlite3

# JDK baixado localmente, caso seja colocado dentro do repositório
**/oracleJdk-*/
**/jdk-*/

